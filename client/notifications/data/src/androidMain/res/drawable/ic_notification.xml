<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon. Android masks a small icon to a flat silhouette and ignores its colours,
  so this cannot be the launcher artwork — that would arrive as a white blob. It is the icon's
  one legible gesture instead: the trajectory and the light it climbs towards, with the planet
  limb and the star field dropped because at 24dp, in one colour, they merge into the rest.

  The curve is `threshold.svg`'s own arc — M120 905 C300 860 668 694 792 250 — scaled by 24/1024
  and then re-weighted, because a 22/1024 stroke lands at half a pixel here. Geometry from the
  master, weights for the size.

  Hand-authored, and the one visual asset in this repository that a cloud session drew. It is a
  reduction of somebody else's mark and should be overruled if it reads wrong on a device.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M3.4,20.4 C7.4,19.4 15.6,15.8 18.3,6.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <path
        android:pathData="M18.3,6.4 m-2.3,0 a2.3,2.3 0 1,1 4.6,0 a2.3,2.3 0 1,1 -4.6,0 z"
        android:fillColor="#FFFFFFFF" />
</vector>
